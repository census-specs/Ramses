# ============================================================================
# Fichier .Rbuildignore — Fichiers exclus du build du package R
# ============================================================================
# Syntaxe : EXPRESSIONS RÉGULIÈRES (regex), pas des globs.
# Chaque ligne est un motif qui sera testé contre le nom de chaque fichier.
# ============================================================================

# --- Dossiers de développement ---
^\.git$
^\.gitignore$
^\.Rbuildignore$
^\.Rproj\.user$
^\.github$
^\.vscode$
^\.idea$

# --- Sauvegardes (syntaxe regex, pas glob !) ---
^.*\.bak$
^.*\.bak\..*$
^.*~$
^backup$

# --- Fichiers système ---
^Thumbs\.db$
^\.DS_Store$
^desktop\.ini$

# --- Fichiers temporaires ---
^.*\.tmp$
^.*\.log$
^.*\.swp$

# --- Python ---
^__pycache__$
^.*\.pyc$

# --- Fichiers générés ---
^formation-complete\.html$
^formation-complete\.pdf$

# --- Fichiers de dev standard ---
^\.travis\.yml$
^appveyor\.yml$
^codecov\.yml$
