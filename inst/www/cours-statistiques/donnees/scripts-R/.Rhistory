setwd("C:/Users/pierr/Downloads/ramses---modern-statistical-gui-for-r/Ramses/inst/www/cours-statistiques/donnees/scripts-R")
# ============================================================================
# RAMSES 1.0 — Génération des jeux de données CSV pour la formation
# ============================================================================
#
# Ce script génère les 2 fichiers CSV utilisés dans les modules :
#   1. 10-parcelles-mais.csv       (modules 01 à 11)
#   2. 40-parcelles-factoriel.csv  (modules 09b, 12)
#
# Utilisation :
#   1. Ouvrir ce script dans RStudio (ou tout autre IDE R)
#   2. Placer le répertoire de travail dans ce dossier : setwd("...")
#   3. Exécuter : source("generer-donnees.R")
#
# Les fichiers seront créés dans le dossier parent (../)
# ============================================================================
# ----------------------------------------------------------------------------
# 1. JEU DE DONNÉES PRINCIPAL : 10 parcelles de maïs
# ----------------------------------------------------------------------------
cat("\n[1/2] Génération du jeu de données principal (10 parcelles)...\n")
donnees_10 <- data.frame(
parcelle   = c("P01", "P02", "P03", "P04", "P05",
"P06", "P07", "P08", "P09", "P10"),
village    = c("Bonabéri", "Bonabéri", "Bonabéri", "Bonabéri", "Bonabéri",
"Bépanda", "Bépanda", "Bépanda", "Bépanda", "Bépanda"),
superficie = c(1.2, 0.8, 1.5, 1.0, 2.0, 0.7, 1.1, 1.4, 0.9, 1.8),
rendement  = c(2.8, 2.4, 3.1, 2.7, 3.4, 2.1, 2.5, 2.9, 2.3, 3.0),
stringsAsFactors = FALSE
)
# Aperçu
print(donnees_10)
# Statistiques de contrôle
cat("\n--- Statistiques descriptives ---\n")
cat("Effectif total :", nrow(donnees_10), "parcelles\n")
cat("Moyenne rendement :", round(mean(donnees_10$rendement), 2), "t/ha\n")
cat("Écart-type rendement :", round(sd(donnees_10$rendement), 3), "t/ha\n")
cat("Médiane rendement :", median(donnees_10$rendement), "t/ha\n")
cat("Min :", min(donnees_10$rendement), "| Max :", max(donnees_10$rendement), "t/ha\n")
# Écrire le CSV (UTF-8, sans row.names)
write.csv(
donnees_10,
file = "../10-parcelles-mais.csv",
row.names = FALSE,
fileEncoding = "UTF-8"
)
cat("\n✅ Fichier '10-parcelles-mais.csv' généré avec succès.\n")
# ----------------------------------------------------------------------------
# 2. JEU DE DONNÉES FACTORIEL : 40 parcelles (2 variétés × 2 fertilisations)
# ----------------------------------------------------------------------------
cat("\n[2/2] Génération du jeu de données factoriel (40 parcelles)...\n")
set.seed(42)  # Reproductibilité : permet d'obtenir exactement les mêmes valeurs
# Plan factoriel complet : 2 variétés × 2 fertilisations × 10 répétitions
donnees_40 <- expand.grid(
variete       = c("A", "B"),
fertilisation = c("Sans", "Avec"),
rep           = 1:10,
stringsAsFactors = FALSE
)
# Moyennes cibles par combinaison (définies dans le module 09b)
# Ces valeurs sont choisies pour montrer :
#   - un effet variété (B meilleure que A)
#   - un effet fertilisation (Avec > Sans)
#   - une interaction (l'écart A vs B augmente avec la fertilisation)
moyennes_cibles <- c(
"A.Sans" = 2.55,
"A.Avec" = 3.10,
"B.Sans" = 2.70,
"B.Avec" = 3.55
)
# Écart-type commun à tous les groupes (homoscédasticité)
sd_commun <- 0.22
# Générer les rendements aléatoirement autour des moyennes cibles
donnees_40$rendement <- round(
mapply(
function(v, f) {
cle <- paste(v, f, sep = ".")
rnorm(1, mean = moyennes_cibles[cle], sd = sd_commun)
},
donnees_40$variete,
donnees_40$fertilisation
),
2  # Arrondir à 2 décimales
)
# Ordonner par variété, puis fertilisation, puis répétition
donnees_40 <- donnees_40[order(donnees_40$variete,
donnees_40$fertilisation,
donnees_40$rep), ]
# Créer l'identifiant de parcelle (P001, P002, ..., P040)
donnees_40$parcelle <- sprintf("P%03d", seq_len(nrow(donnees_40)))
# Réorganiser les colonnes dans l'ordre logique
donnees_40 <- donnees_40[, c("parcelle", "variete", "fertilisation", "rendement")]
# Réinitialiser les noms de lignes
rownames(donnees_40) <- NULL
# Aperçu
cat("\n--- Aperçu des 8 premières lignes ---\n")
print(head(donnees_40, 8))
# Statistiques de contrôle
cat("\n--- Moyennes par combinaison ---\n")
moyennes_observees <- tapply(
donnees_40$rendement,
list(donnees_40$variete, donnees_40$fertilisation),
mean
)
print(round(moyennes_observees, 2))
cat("\n--- Statistiques globales ---\n")
cat("Effectif total :", nrow(donnees_40), "parcelles\n")
cat("Moyenne globale :", round(mean(donnees_40$rendement), 2), "t/ha\n")
cat("Écart-type global :", round(sd(donnees_40$rendement), 3), "t/ha\n")
# Écrire le CSV
write.csv(
donnees_40,
file = "../40-parcelles-factoriel.csv",
row.names = FALSE,
fileEncoding = "UTF-8"
)
cat("\n✅ Fichier '40-parcelles-factoriel.csv' généré avec succès.\n")
# ----------------------------------------------------------------------------
# 3. VÉRIFICATION : relecture des fichiers créés
# ----------------------------------------------------------------------------
cat("\n[Vérification] Relecture des fichiers CSV...\n")
verif_10 <- read.csv("../10-parcelles-mais.csv",
encoding = "UTF-8",
stringsAsFactors = FALSE)
verif_40 <- read.csv("../40-parcelles-factoriel.csv",
encoding = "UTF-8",
stringsAsFactors = FALSE)
cat("  10-parcelles-mais.csv :", nrow(verif_10), "lignes, ",
ncol(verif_10), "colonnes\n")
cat("  40-parcelles-factoriel.csv :", nrow(verif_40), "lignes, ",
ncol(verif_40), "colonnes\n")
# Vérification de l'encodage (accents corrects)
cat("\nVérification des accents :\n")
cat("  Villages dans le fichier 10 parcelles :",
paste(unique(verif_10$village), collapse = ", "), "\n")
# ----------------------------------------------------------------------------
# 4. TEST RAPIDE : vérifier que l'interaction existe bien dans le fichier 40
# ----------------------------------------------------------------------------
cat("\n[Test] Vérification de l'interaction variété × fertilisation...\n")
modele_test <- aov(rendement ~ variete * fertilisation, data = verif_40)
resume <- summary(modele_test)
cat("\n--- Résultat de l'ANOVA 2 facteurs ---\n")
print(resume)
cat("\n=== Script terminé avec succès ! ===\n")
cat("Les 2 fichiers CSV sont prêts dans le dossier 'donnees/'.\n\n")
